# These settings belong to the ordinary web server, never the browser.
MOTION_BACKEND=fc
MOTION_REMOTE_ENDPOINT=https://<hymotion-trigger>.cn-hangzhou.fcapp.run
MOTION_REMOTE_OSS_BUCKET=<private-oss-bucket>
MOTION_REMOTE_OSS_REGION=cn-hangzhou
MOTION_REMOTE_OSS_PREFIX=results/hymotion
MOTION_REMOTE_TIMEOUT_SECONDS=1820
# Supply the following privately through the host's service environment/secret manager.
# No actual credentials are stored here. STS credentials also require the token and an external refresh mechanism.
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_SECURITY_TOKEN=
